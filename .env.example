# Server Configuration
ENV=development

# Port to access Trove on your host machine
TROVE_PORT=8080

# Database Configuration
DB_TYPE=postgres                    # Options: sqlite, postgres
DB_HOST=postgres 
DB_PORT=5432
DB_NAME=trove
DB_USER=trove
DB_PASSWORD=trove_dev_password

# SQLite Configuration (if DB_TYPE=sqlite)
# DB_PATH=./data/trove.db

# Storage Configuration
STORAGE_BACKEND=disk                # Options: disk, memory, s3
STORAGE_PATH=./data/files           # For disk backend
# TEMP_DIR=/tmp                     # Temp directory for uploads (defaults to system temp)

# S3 Configuration (if STORAGE_BACKEND=s3)
# Uses AWS SDK defaults for credentials and endpoint:
#   - AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY (credentials)
#   - AWS_REGION (region)
#   - AWS_ENDPOINT_URL (custom endpoint for S3-compatible services)
#   - ~/.aws/credentials and ~/.aws/config (shared config)
#   - IAM roles (EC2/ECS/Lambda)
S3_BUCKET=trove                     # Required: bucket name
S3_USE_PATH_STYLE=false             # Set to true for MinIO/rustfs

DEFAULT_USER_QUOTA=10G              # Supports: B, K/KB, M/MB, G/GB, T/TB or raw bytes
MAX_UPLOAD_SIZE=500M                # Supports: B, K/KB, M/MB, G/GB, T/TB or raw bytes

# Security
SESSION_SECRET=change_this_to_a_random_secret_in_production
CSRF_ENABLED=true

ENABLE_REGISTRATION=true
ENABLE_FILE_DEDUPLICATION=true

# Deleted Items
DELETED_RETENTION_DAYS=30           # Days before deleted items are permanently removed (default: 30)
# DELETED_CLEANUP_INTERVAL_MIN=60   # How often to run cleanup in minutes (default: 60)

# Video Transcoding
# Video uploads are converted in the background by the transcoder worker
# (separate container running ffmpeg) into H.264/AAC MP4 (max 720p,
# faststart) for in-browser streaming. The original file is kept for
# downloads and the MP4 variant counts toward the user's storage quota.
TRANSCODE_ENABLED=true              # Enqueue transcode jobs for video uploads
# TRANSCODE_POLL_INTERVAL=5s        # How often the worker polls for new jobs
# TRANSCODE_WORKERS=1               # Concurrent jobs (ffmpeg is CPU-heavy; keep at 1)
# TRANSCODE_MAX_ATTEMPTS=3          # Retries before a job is marked failed
# TRANSCODE_TIMEOUT=2h              # Per-job timeout
# TRANSCODE_PRESET=medium           # libx264 preset (ultrafast..veryslow)
# TRANSCODE_CRF=23                  # Quality value (lower = better quality, larger files)
# TRANSCODE_MAX_HEIGHT=720          # Maximum output height in pixels
# TRANSCODE_STALE_JOB_AGE=30m       # Re-queue jobs stuck in "processing" after this
# FFMPEG_PATH=ffmpeg                # Path to the ffmpeg binary (worker container)
# FFPROBE_PATH=ffprobe              # Path to the ffprobe binary (worker container)

# Advanced (defaults are sensible, only change if needed)
# PORT=8080                         # Container internal port (default: 8080)
# HOST=0.0.0.0                      # Container bind address (default: 0.0.0.0)
# SESSION_DURATION=168h             # Session expiry (default: 7 days)
# BCRYPT_COST=10                    # Password hashing cost (default: 10, range: 10-14)
